# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR BACKEND GATEWAY DE LAZO V1
# ==============================================================================
# Este archivo es una plantilla de ejemplo. Para utilizarlo:
# 1. Copia este archivo como .env dentro de la carpeta server/
#    (ejecuta: cp server/.env.example server/.env)
# 2. Reemplaza "tu_clave_api_aqui" con tu clave real de Google AI Studio.
#
# IMPORTANTE: server/.env está explícitamente ignorado por .gitignore para
# garantizar que NUNCA se suba a GitHub ni se exponga al frontend.
# ==============================================================================

# Puerto local del servidor backend
PORT=3001

# Clave API de Google AI Studio (Gemini)
# Obtenla de forma gratuita en: https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_clave_api_aqui

# Modelo para Gemini Multimodal Live API
# - models/gemini-2.5-flash-native-audio-preview-12-2025 (Modelo nativo de audio bidireccional en tiempo real para Live API)
GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025

# Voz preconstruida de síntesis para la enfermera/asistente virtual "Lazo"
# Opciones disponibles en Gemini Live:
# - Aoede (Femenina cálida y empática, recomendada para español clínico)
# - Kore (Femenina pausada y clara)
# - Charon (Masculina formal)
# - Fenrir (Masculina grave)
# - Puck (Juvenil y vivaz)
GEMINI_VOICE=Aoede

# ==============================================================================
# SEGURIDAD Y CONTROL DE ACCESO ACADÉMICO
# ==============================================================================
# Clave compartida para evaluación académica del comité (sin valor por defecto en código)
ACADEMIC_PASSKEY=tu_clave_academica_secreta_aqui

# Secreto criptográfico para firma HMAC de sesiones
SESSION_SECRET=tu_secreto_hmac_aleatorio_de_64_caracteres

# Duración y concurrencia de llamadas clínicas
CALL_MAX_DURATION_SECONDS=300
CALL_WARNING_DURATION_SECONDS=270
MAX_CONCURRENT_CALLS=3

# ==============================================================================
# BASE DE DATOS Y ALMACENAMIENTO (RENDER POSTGRESQL & OBJECT STORAGE)
# ==============================================================================
# Cadena de conexión para Render PostgreSQL (dejar vacío en modo local JSON)
# DATABASE_URL=postgresql://lazo_user:password@dpg-xxxx.render.com/lazo_db
DATABASE_URL=
STORAGE_PROVIDER=local
